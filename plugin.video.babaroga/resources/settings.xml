<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="General">
        <setting id="country" type="labelenum" label="My country" values="Auto|MK|AL|XK|RS|ME|BA|HR|SI|BG|GR|RO" default="Auto"/>
        <setting id="show_untested" type="bool" label="Show channels not yet verified" default="true"/>
        <setting id="hide_geolocked" type="bool" label="Hide channels locked to other countries" default="false"/>
        <setting id="auto_update" type="bool" label="Update the channel list daily" default="true"/>
        <setting id="health_check" type="bool" label="Check channels in the background" default="true"/>
    </category>
    <category label="TV guide">
        <setting label="Install IPTV Manager" type="action" action="InstallAddon(service.iptv.manager)" option="close" visible="!System.HasAddon(service.iptv.manager)"/>
        <setting id="iptv.enabled" type="bool" label="Show channels in Kodi's TV section (IPTV Manager)" default="false" visible="System.HasAddon(service.iptv.manager)"/>
        <setting id="iptv.my_lists" type="bool" label="Include my channel lists (My sources)" default="true" enable="eq(-1,true)" visible="System.HasAddon(service.iptv.manager)" subsetting="true"/>
        <setting id="iptv.my_guides" type="bool" label="Load the TV guide named in my lists (url-tvg)" default="true" enable="eq(-1,true)" visible="System.HasAddon(service.iptv.manager)" subsetting="true"/>
        <setting label="IPTV Manager settings" type="action" action="Addon.OpenSettings(service.iptv.manager)" enable="eq(-3,true)" option="close" visible="System.HasAddon(service.iptv.manager)" subsetting="true"/>
        <setting id="iptv.channels_uri" type="text" default="plugin://plugin.video.babaroga/?action=iptv_channels" visible="false"/>
        <setting id="iptv.epg_uri" type="text" default="plugin://plugin.video.babaroga/?action=iptv_epg" visible="false"/>
    </category>
</settings>
